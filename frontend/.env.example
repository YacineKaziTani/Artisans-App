# Stripe (booking + product payments)
# Get this from https://dashboard.stripe.com/test/apikeys — the publishable
# (pk_test_...) key, not the secret key.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Backend URL for the real-time messaging socket connection.
# Defaults to http://localhost:3000 if unset.
VITE_SOCKET_URL=http://localhost:3000
