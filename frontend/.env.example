# Base URL of the backend API, including the /api suffix.
# Leave unset locally — the Vite dev proxy forwards /api to localhost:3000.
# On Vercel: https://<your-backend>.onrender.com/api
VITE_API_URL=

# Backend URL for the real-time messaging socket connection (no /api suffix).
# Defaults to http://localhost:3000 if unset.
VITE_SOCKET_URL=http://localhost:3000

# Stripe (booking + product payments)
# The publishable (pk_test_...) key, not the secret key.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Local testing: show Book/Buy even when a shop has not onboarded to Connect.
# Must be paired with STRIPE_TEST_BYPASS_CONNECT=true on the backend.
VITE_STRIPE_BYPASS_CONNECT=false
