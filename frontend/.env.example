# Base URL of the backend API, including the /api suffix.
# Leave unset locally — the Vite dev proxy forwards /api to localhost:3000.
# On Vercel: https://<your-backend>.onrender.com/api
VITE_API_URL=

# Backend URL for the real-time messaging socket connection (no /api suffix).
# Defaults to http://localhost:3000 if unset.
VITE_SOCKET_URL=http://localhost:3000

# Stripe (booking + product payments)
# The publishable (pk_test_...) key, not the secret key.
# (To test Book/Buy on shops that haven't onboarded to Stripe Connect, set
# STRIPE_TEST_BYPASS_CONNECT=true on the backend — the frontend follows it.)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Error monitoring (optional). The DSN of a Sentry "React" project — from
# Sentry → Project Settings → Client Keys. Leave empty to turn it off.
VITE_SENTRY_DSN=

# Analytics (optional, cookieless). Set ONE of these:
# Plausible — the domain as registered in Plausible (e.g. artisanmarket.com).
VITE_PLAUSIBLE_DOMAIN=
# Self-hosted Plausible only: its script URL.
VITE_PLAUSIBLE_SRC=
# Umami — the website ID from Umami's settings (and VITE_UMAMI_SRC if self-hosted).
VITE_UMAMI_WEBSITE_ID=
VITE_UMAMI_SRC=
