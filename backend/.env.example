# Database (Postgres)
# Local:  postgres://postgres:password@localhost:5432/artisans_app
# Render: copy the Internal Database URL from the dashboard.
DATABASE_URL=postgres://postgres:@localhost:5432/artisans_app
# TLS is on by default (hosted Postgres needs it). Set to false for a local
# Postgres without TLS.
DB_SSL=

# Optional: the Postgres server `npm run test:tempdb` creates its throwaway
# test database on. Defaults to the server in DATABASE_URL.
TEST_DB_SERVER_URL=

# The schema is managed by migrations in src/migrations, applied automatically
# on boot. After changing an entity, run
#   npm run migration:generate -- src/migrations/DescribeTheChange
# and commit the generated file. `npm run migration:check` reports drift.
#
# DB_SYNC=true makes TypeORM rewrite the schema straight from the entities
# instead (it can drop columns on a rename). Only for throwaway databases —
# never point it at one with data you care about.
DB_SYNC=

# Unpaid checkouts (orders reserving stock, bookings holding a time slot) are
# released after this many minutes. Minimum 5, default 30.
CHECKOUT_TTL_MINUTES=30

# Clients can cancel a confirmed (paid) booking for a full refund only up to
# this many hours before the appointment. Pending bookings (not yet confirmed
# by the artisan, nothing charged) can always be cancelled. Default 24.
BOOKING_FREE_CANCELLATION_HOURS=24

# Auth
JWT_SECRET=replace-with-a-long-random-string

# Comma-separated list of allowed frontend origins for CORS + Socket.io.
# Also used for password-reset links and Stripe Connect return URLs.
# Defaults to http://localhost:5173 if unset.
FRONTEND_URL=http://localhost:5173

# Set to 1 when running behind a reverse proxy (Render, Fly, nginx) so
# rate limiting keys off the real client IP instead of the proxy's.
TRUST_PROXY=

# Email. Resend is used when RESEND_API_KEY is set, otherwise SMTP, otherwise
# emails are just logged to the console.
# MAIL_FROM must be on a domain verified in Resend to reach real inboxes;
# onboarding@resend.dev only delivers to your own Resend account address.
RESEND_API_KEY=
MAIL_FROM=onboarding@resend.dev
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Where the help page's contact form is sent (comma-separated). Defaults to
# every admin account's email. Replies go straight to the visitor.
SUPPORT_EMAIL=

# New accounts must confirm their email (via a link) before buying, booking,
# messaging or posting. Existing accounts count as confirmed. Set to false
# only while email can't reach real users yet (e.g. MAIL_FROM is still
# onboarding@resend.dev) — otherwise new users could never confirm. The admin
# dashboard's "Email delivery" card shows whether email is set up.
REQUIRE_EMAIL_VERIFICATION=true

# Cloudinary (shop photos, product images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe (booking + product payments)
# Get these from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen --forward-to localhost:3000/api/bookings/webhook`
# locally. When deployed, create an endpoint pointing at
# https://<your-backend>.onrender.com/api/bookings/webhook and use its secret.
STRIPE_WEBHOOK_SECRET=whsec_...

# Local/testing only: allow Book/Buy on shops that have not onboarded to
# Stripe Connect. Must be paired with VITE_STRIPE_BYPASS_CONNECT on the front.
STRIPE_TEST_BYPASS_CONNECT=false

# Percentage of each booking/order kept by the platform; the rest is
# transferred to the artisan's connected Stripe account. Defaults to 10.
PLATFORM_COMMISSION_PERCENT=10

NODE_ENV=development

# Error monitoring (optional). The DSN of a Sentry "Node.js" project. Every
# logged server error (and failed startup) is reported. Leave empty to disable.
SENTRY_DSN=
# Defaults to NODE_ENV.
SENTRY_ENVIRONMENT=
