# Database (Postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=artisans_app

# Auth
JWT_SECRET=replace-with-a-long-random-string

# Used to build the password-reset link sent by email
FRONTEND_URL=http://localhost:5173

# Email (password reset). Optional in development — if unset, reset emails
# are logged to the server console instead of actually being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@artisans-app.local

# Cloudinary (shop photos, product images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe (booking + product payments)
# Get these from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen --forward-to localhost:3000/api/bookings/webhook`
# locally, or your webhook endpoint's signing secret in production
STRIPE_WEBHOOK_SECRET=whsec_...

NODE_ENV=development
