# Database (Postgres)
# Local:  postgres://postgres:password@localhost:5432/artisans_app
# Render: copy the Internal Database URL from the dashboard.
DATABASE_URL=postgres://postgres:@localhost:5432/artisans_app

# Set to "true" to let TypeORM build the schema from the entities on boot.
# Needed for the first hosted deploy; remove it once you switch to migrations.
DB_SYNC=

# Auth
JWT_SECRET=replace-with-a-long-random-string

# Comma-separated list of allowed frontend origins for CORS + Socket.io.
# Also used for password-reset links and Stripe Connect return URLs.
# Defaults to http://localhost:5173 if unset.
FRONTEND_URL=http://localhost:5173

# Set to 1 when running behind a reverse proxy (Render, Fly, nginx) so
# rate limiting keys off the real client IP instead of the proxy's.
TRUST_PROXY=

# Email. Resend is used when RESEND_API_KEY is set, otherwise SMTP, otherwise
# emails are just logged to the console.
# MAIL_FROM must be on a domain verified in Resend to reach real inboxes;
# onboarding@resend.dev only delivers to your own Resend account address.
RESEND_API_KEY=
MAIL_FROM=onboarding@resend.dev
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Cloudinary (shop photos, product images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe (booking + product payments)
# Get these from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen --forward-to localhost:3000/api/bookings/webhook`
# locally. When deployed, create an endpoint pointing at
# https://<your-backend>.onrender.com/api/bookings/webhook and use its secret.
STRIPE_WEBHOOK_SECRET=whsec_...

# Local/testing only: allow Book/Buy on shops that have not onboarded to
# Stripe Connect. Must be paired with VITE_STRIPE_BYPASS_CONNECT on the front.
STRIPE_TEST_BYPASS_CONNECT=false

# Percentage of each booking/order kept by the platform; the rest is
# transferred to the artisan's connected Stripe account. Defaults to 10.
PLATFORM_COMMISSION_PERCENT=10

NODE_ENV=development
