# Database (Postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=artisans_app

# Auth
JWT_SECRET=replace-with-a-long-random-string

# Comma-separated list of allowed frontend origins for CORS + Socket.io.
# Defaults to http://localhost:5173 if unset.
CORS_ORIGIN=http://localhost:5173

# Used to build the password-reset link sent by email, and Stripe Connect
# onboarding return/refresh URLs.
FRONTEND_URL=http://localhost:5173

# Email (password reset). Optional in development — if unset, reset emails
# are logged to the server console instead of actually being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@artisans-app.local

# Cloudinary (shop photos, product images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe (booking + product payments)
# Get these from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen --forward-to localhost:3000/api/bookings/webhook`
# locally, or your webhook endpoint's signing secret in production.
STRIPE_WEBHOOK_SECRET=whsec_...

# Percentage of each booking/order kept by the platform; the rest is
# transferred to the artisan's connected Stripe account. Defaults to 10.
PLATFORM_COMMISSION_PERCENT=10

NODE_ENV=development
